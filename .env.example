# 【必填】学号 / Student ID
STUDENT_ID = "Your Student ID"
# 【必填】密码 / Password
PASSWORD = "Your Password"
# 【必填】教务系统地址 / URP base URL
URP_BASE_URL = "https://jwxt.imu.edu.cn"
# 验证码保存路径（手动回退时使用）/ Captcha save path (for manual fallback)
CAPTCHA_SAVE_PATH = "captcha.jpg"
# 加密后缀（一般不需要改）/ Encryption suffix (usually不需要 change)
URP_SUFFIX = "{Urp602019}"
# 请求超时秒数（推荐 10-30）/ Request timeout in seconds (recommended 10-30)
TIMEOUT = 15
# 验证码重试次数（推荐 3 次以下）/ Captcha retry count (recommended ≤3)
MAX_OCR_RETRIES = 3
# TLS 验证（建议保持 true）/ TLS verification (recommended true)
VERIFY_TLS = true
